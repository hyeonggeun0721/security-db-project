# security_db — 환경변수 예시
# ---------------------------------------------------------------------------
# 실제 값은 .env 에 채운다. .env 는 .gitignore 로 제외돼 있다(커밋 금지).
# 여기 나열된 변수만 코드가 실제로 읽는다. "필수/선택" 과 "쓰는 스크립트" 를 옆에 적었다.
# 셸에서 쓰려면:  set -a; source .env; set +a
# ---------------------------------------------------------------------------

# === DB 접속 ===============================================================
# [선택] 대상 데이터베이스 이름. 미설정 시 모든 스크립트가 'security_db' 기본값.
#        (호스트/포트/사용자/비밀번호는 libpq 표준 PGHOST/PGPORT/PGUSER/PGPASSWORD
#         또는 ~/.pgpass 를 쓴다 — 로컬 trust 개발 환경에서는 불필요.)
PGDATABASE=security_db

# [선택] SOC 대시보드가 붙을 DB role. 미설정 시 'security_manager'
#        (RBAC 상 전체 SELECT + RLS 우회, 쓰기 없음 = 읽기 전용 대시보드에 적합).
#        쓰는 곳: scripts/soc_dashboard.py
SOC_DASHBOARD_DB_USER=security_manager

# [선택] 합성 이벤트 생성기가 붙을 DB role. 미설정 시 'svc_event_ingest'
#        (INSERT 전용 최소권한 계정, RLS 가 '[SIM]' 태그를 강제).
#        쓰는 곳: scripts/generate_synthetic_events.py
SYNTH_DB_USER=svc_event_ingest

# === SOC 대시보드 로그인 게이트 ===========================================
# [필수 — 대시보드 실행 시] 대시보드 접속 비밀번호의 bcrypt 해시.
#        미설정이면 대시보드가 열리지 않는다(fail-closed).
#        생성:  python3 -c "import bcrypt; print(bcrypt.hashpw(b'비밀번호', bcrypt.gensalt()).decode())"
#        쓰는 곳: scripts/soc_dashboard.py
SOC_DASHBOARD_AUTH_HASH=

# === 실시간 알림 (scripts/alert_poller.py → scripts/alert_notifier.py) ====
# [선택] '[SIM]' 합성 CRITICAL 이벤트도 알림 대상에 포함할지. 0/false/no 면 제외. 기본 포함.
#        쓰는 곳: scripts/alert_poller.py
ALERT_INCLUDE_SIM=1

# [선택] Slack Incoming Webhook URL. 있으면 알림을 Slack 으로도 보낸다.
#        쓰는 곳: scripts/alert_notifier.py
SLACK_WEBHOOK_URL=

# [선택] 이메일(SMTP) 알림. HOST 와 TO 가 둘 다 있어야 이메일 채널이 동작한다.
#        쓰는 곳: scripts/alert_notifier.py
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=

# === NVD 연동 (scripts/nvd_sync.py, scripts/nvd_watch.py) =================
# [선택] NVD API 키. 없으면 익명(요청 속도 제한이 훨씬 빡빡함).
#        발급: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
