# ── 자격증명 / 비밀 ─────────────────────────────
.pgpass
.env
*.env
.env.*
# .env.example 은 값 없는 설명용 템플릿이라 커밋한다
!.env.example
secrets/
**/secrets*
**/*secret*
**/*credential*
*.pem
*.key

# ── DB 덤프 / 백업 (실데이터 포함 가능) ──────────
db_backups/
*.dump
*.sql.gz
*.backup

# ── 파이썬 ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ── OS / 에디터 ─────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── 로그 / 임시 ─────────────────────────────────
*.log
logs/
*.tmp
Claude outputs/

# 참고: sql/ 의 *.sql 마이그레이션과 sql/schema_dump.sql 은 커밋 대상이다.
#       auth_hardening.sql 의 'Xxx#Tmp-2026!chg' 류는 "임시 예시 비밀번호"이며
#       실제 운영 비밀번호가 아니다(운영 반영 시 교체 전제).

# KISA 스캔 증적(import 로그)은 예외로 포함
!reports/kisa_scans/*.log
